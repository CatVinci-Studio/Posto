{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Posto",
  "version": "0.1.0",
  "identifier": "com.catvinci.posto",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Posto",
        "width": 1280,
        "height": 800,
        "minWidth": 380,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Agent-based email manager",
    "longDescription": "Posto turns your inbox into a task list, powered by Agents.",
    "iOS": {
      "minimumSystemVersion": "14.0"
    },
    "android": {
      "minSdkVersion": 24
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["posto"]
      },
      "mobile": [
        {
          "host": "oauth.posto.app",
          "pathPrefix": ["/callback"]
        }
      ]
    }
  }
}
